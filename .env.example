# ───────── Application ─────────
APP_URL=http://localhost:3100
# Directory for the development JSON data store (relative to apps/web)
DATA_DIR=.data
# Comma-separated emails that become platform admins on sign-up
ADMIN_EMAILS=

# ───────── Secrets (required in production, min 16 chars each) ─────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
LICENSE_SIGNING_SECRET=
DOWNLOAD_SIGNING_SECRET=
APP_ENCRYPTION_KEY=
SANDBOX_WEBHOOK_SECRET=

# ───────── Payments ─────────
# sandbox (development, no money moves) | stripe (use test-mode keys in development)
PAYMENT_PROVIDER=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Refuse sandbox payments in production unless explicitly allowed (staging demos only)
ALLOW_SANDBOX_PAYMENTS=false

# ───────── AI providers (server-side only; never exposed to browsers) ─────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Allow Playground demo runs to use live providers (costs money). Default: sandbox only.
DEMO_ALLOW_PROVIDERS=false
DEMO_RUNS_PER_DAY=5
CREDITS_PER_HOSTED_PURCHASE=300

# ───────── Email (Resend) ─────────
# Without these, production cannot send verification/reset/receipt emails, so nobody can verify and buy.
RESEND_API_KEY=
# e.g. "AgentForge AI <no-reply@yourdomain.com>" — the domain must be verified in Resend
MAIL_FROM=
# Emergency fallback only: mark new accounts as verified without an email (use if no email provider yet)
AUTO_VERIFY_EMAIL=false

# ───────── Optional services ─────────
# Python LangGraph execution service (apps/api)
AI_SERVICE_URL=
AI_SERVICE_TOKEN=
REDIS_URL=
MALWARE_SCAN_URL=
# Supabase (production data/auth/storage — adapter not yet wired; see PROGRESS.md)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
# Path to the products/ directory with downloadable deliverables
PRODUCTS_DIR=
# Feature flags
FEATURE_SELLERS=false
# Set to "off" when running multiple web instances (run one scheduler worker instead)
SCHEDULER=
