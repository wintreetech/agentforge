{
  "name": "agentforge-mcp-server-kit",
  "version": "1.0.0",
  "description": "Production-ready TypeScript template for building Model Context Protocol (MCP) servers.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": { "node": ">=22.6" },
  "bin": { "agentforge-mcp-server": "dist/index.js" },
  "scripts": {
    "dev": "node --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3"
  }
}
